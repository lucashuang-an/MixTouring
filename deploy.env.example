# 复制到仓库之外的运行环境文件，填写后通过MT_RUNTIME_ENV_FILE传给Compose。
MT_PUBLIC=1
MT_PUBLIC_ORIGIN=https://replace-with-your-domain.example
MT_ACCESS_USERS={"invite-user":"replace-with-the-64-character-hash-from-create-invite"}
MT_MAX_CONCURRENT=4
MT_API_PER_MINUTE=20
MT_DAILY_UPSTREAM_LIMIT=200
# 配置下列三类每次尝试的预估扣款后才能启用金额额度。按供应商及模型自行填写。
# MT_DAILY_BUDGET_CNY=your-daily-estimated-budget
# MT_UPSTREAM_COST_CNY={"model":model-attempt-estimate,"search":search-attempt-estimate,"map":map-attempt-estimate}
# 只有实际可信反向代理的socket地址才能填写。代理须覆盖X-Real-IP。
# MT_TRUSTED_PROXIES=172.18.0.1
MT_COMPOSE_PROVIDER=openai
OPENAI_API_KEY=replace-at-runtime
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
TRAVEL_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=replace-at-runtime
# MAP_PROVIDER=google
# GOOGLE_MAPS_API_KEY=replace-at-runtime
